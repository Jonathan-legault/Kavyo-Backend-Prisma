// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String  @id @default(uuid()) @db.Uuid
  email        String  @unique @db.VarChar(320)
  passwordHash String  @map("password_hash") @db.VarChar(255)
  firstName    String? @map("first_name") @db.VarChar(100)
  lastName     String? @map("last_name") @db.VarChar(100)
  isActive     Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  roles UserRole[]

  @@map("users")
}

model Role {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique @db.VarChar(50)
  description String? @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  users UserRole[]

  @@map("roles")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model Product {
  id          String  @id @default(uuid()) @db.Uuid
  barcode     String  @unique @db.VarChar(64)
  productName String  @map("product_name") @db.VarChar(500)
  brand       String? @db.VarChar(500)

  quantityValue Decimal? @map("quantity_value") @db.Decimal(12, 3)
  quantityUnit  String?  @map("quantity_unit") @db.VarChar(30)
  quantityText  String?  @map("quantity_text") @db.VarChar(150)

  categories String? @db.Text

  isActive          Boolean            @default(true) @map("is_active")
  priceObservations PriceObservation[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([productName])
  @@index([brand])
  @@map("products")
}

model Retailer {
  id       String  @id @default(uuid()) @db.Uuid
  name     String  @unique @db.VarChar(150)
  website  String? @db.VarChar(500)
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  stores Store[]

  @@map("retailers")
}

model Store {
  id         String @id @default(uuid()) @db.Uuid
  retailerId String @map("retailer_id") @db.Uuid

  name       String? @db.VarChar(200)
  address    String? @db.VarChar(300)
  city       String? @db.VarChar(100)
  province   String? @db.VarChar(50)
  postalCode String? @map("postal_code") @db.VarChar(20)

  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)

  isActive          Boolean            @default(true) @map("is_active")
  priceObservations PriceObservation[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  retailer Retailer @relation(fields: [retailerId], references: [id], onDelete: Restrict)

  @@index([retailerId])
  @@index([city])
  @@index([postalCode])
  @@map("stores")
}

model SourceSystem {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique @db.VarChar(100)
  sourceType  String  @map("source_type") @db.VarChar(50)
  baseUrl     String? @map("base_url") @db.VarChar(500)
  licenseInfo String? @map("license_info") @db.Text
  isActive    Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  ingestBatches     IngestBatch[]
  priceObservations PriceObservation[]

  @@map("source_systems")
}

model IngestBatch {
  id             String @id @default(uuid()) @db.Uuid
  sourceSystemId String @map("source_system_id") @db.Uuid

  status      String    @db.VarChar(30)
  startedAt   DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  recordsRead     Int @default(0) @map("records_read")
  recordsInserted Int @default(0) @map("records_inserted")
  recordsUpdated  Int @default(0) @map("records_updated")
  recordsRejected Int @default(0) @map("records_rejected")

  sourceReference String? @map("source_reference") @db.VarChar(500)
  errorMessage    String? @map("error_message") @db.Text

  sourceSystem      SourceSystem       @relation(fields: [sourceSystemId], references: [id], onDelete: Restrict)
  priceObservations PriceObservation[]

  @@index([sourceSystemId])
  @@index([status])
  @@index([startedAt])
  @@map("ingest_batches")
}

model PriceObservation {
  id String @id @default(uuid()) @db.Uuid

  productId      String  @map("product_id") @db.Uuid
  storeId        String  @map("store_id") @db.Uuid
  sourceSystemId String  @map("source_system_id") @db.Uuid
  ingestBatchId  String? @map("ingest_batch_id") @db.Uuid

  regularPrice Decimal? @map("regular_price") @db.Decimal(10, 3)
  salePrice    Decimal? @map("sale_price") @db.Decimal(10, 3)

  currency String @default("CAD") @db.VarChar(3)

  observedAt DateTime  @map("observed_at") @db.Timestamptz(6)
  validFrom  DateTime? @map("valid_from") @db.Timestamptz(6)
  validUntil DateTime? @map("valid_until") @db.Timestamptz(6)

  sourceRecordId String? @map("source_record_id") @db.VarChar(150)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product      Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  store        Store        @relation(fields: [storeId], references: [id], onDelete: Restrict)
  sourceSystem SourceSystem @relation(fields: [sourceSystemId], references: [id], onDelete: Restrict)
  ingestBatch  IngestBatch? @relation(fields: [ingestBatchId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([storeId])
  @@index([sourceSystemId])
  @@index([ingestBatchId])
  @@index([observedAt])
  @@index([productId, storeId, observedAt])
  @@map("price_observations")
}
